widget = {
	allow_outside = yes
	name = "event_window_trade_good_selection"
	size = { 350 250 } # Size of the insert inside the event window; needs to fit under the text box since a margin will only push the content and not the widget

	vbox = {
		container = {
			allow_outside = yes
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			datacontext = "[GetPlayer.MakeScope]"
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 350 250 }
				blockoverride "scrollbox_content" {
					fixedgridbox = {
						addcolumn = 80
						addrow = 80
						datamodel_wrap = 4
						flipdirection = yes
						datamodel = "[GetPlayer.MakeScope.GetList('possible_trade_goods')]"

						item = {
							button_standard = {
								size = { 76 76 }
								datacontext = "[GetScriptedGui('zz_valyria_trade_good_selecting')]"
								down = "[GetScriptedGui( 'zz_valyria_trade_good_selecting' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_trade_good', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
								onclick = "[GetScriptedGui( 'zz_valyria_trade_good_selecting' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_trade_good', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
								tooltip = "[Scope.GetFlagName]"

								icon = {
									size = { 44 44 }
									parentanchor = top|hcenter
									position = { 0 6 }
									texture = "[Concatenate( Concatenate( 'gfx/interface/icons/trade/trade_goods/', Scope.GetFlagKey ), '.dds' )]"
								}
								text_single = {
									text = "[Scope.GetFlagName]"
									parentanchor = bottom|hcenter
									position = { 0 -4 }
									max_width = 72
									align = center|nobaseline
									using = Font_Size_Small
								}
							}
						}
					}
				}
			}
		}
	}
}
