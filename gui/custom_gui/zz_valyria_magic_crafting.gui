types zz_valyria_magic_crafting {
	type zz_valyria_magic_crafting = window {
		name = "zz_valyria_magic_crafting"
		layer = windows_layer
		using = Window_Background
		using = Window_Decoration
		parentanchor = top|right
		#parentanchor = center#

		movable = no
		size = { 1150 100% } # narrower: columns trimmed to fit
		datacontext = "[GetScriptedGui('zz_valyria_magic_crafting')]"
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			using = Window_Position_MainTab
	
		}
	
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			using = Window_Position_MainTab_Hide
		}

		margin_widget = {
			size = { 100% 100% }
			margin = { 0 30 }
			margin_right = 13

			widget = {
				size = { 100% 100% }
				background = {
					texture = "gfx/interface//illustrations/magic_casting/zz_magic_item_crafting_base.dds"
					margin = { -25 -25 }
					fittype = centercrop
					alpha = 1
								
					using = Mask_Rough_Edges
		
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}
				}
				vbox = {
					using = Window_Margins

					header_pattern = {
						layoutpolicy_horizontal = expanding

						blockoverride "header_text"
						{
							raw_text = "Item Crafting"
						}

						blockoverride "button_close"
						{
							onclick = "[GetScriptedGui('zz_valyria_magic_crafting_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}
					}
					# Crafting window tabs (zz_valyria_crafting_tab): Items and Potions
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						button_tab = {
							datacontext = "[GetScriptedGui('zz_valyria_crafting_tab')]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_crafting_tab', MakeScopeFlag('items') ).End )]"
							down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_crafting_tab', MakeScopeFlag('items') ).End )]"
							text_single = {
								raw_text = "Items"
								margin = { 20 6 }
								align = center|nobaseline
								resizeparent = yes
							}
						}
						button_tab = {
							datacontext = "[GetScriptedGui('zz_valyria_crafting_tab')]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_crafting_tab', MakeScopeFlag('potions') ).End )]"
							down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_crafting_tab', MakeScopeFlag('potions') ).End )]"
							text_single = {
								raw_text = "Potions"
								margin = { 20 6 }
								align = center|nobaseline
								resizeparent = yes
							}
						}
						expand = {}
					}
					hbox = { 
						visible = "[Not( EqualTo_string( GetPlayer.MakeScope.Var('zz_crafting_tab').GetFlagKey, 'potions' ) )]" # Items tab
						layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
						background = {
							using = Background_Area_Dark
						}
						vbox = {
							layoutpolicy_horizontal = growing 
							layoutpolicy_vertical = growing
							vbox = {
								layoutpolicy_horizontal = growing 
								layoutpolicy_vertical = growing
								max_width = 220
								spacer = { size = { 00 30 } }
								text_single = {
									raw_text = "Item Crafter"
									fontsize = 18
									align = left
								}
								spacer = { size = { 00 15 } }
	
								vbox = {
									size = { 200 120 }
									datacontext = "[GetPlayer.MakeScope.Var('zz_item_crafter').Char]"
									portrait_head_small = {}
									text_single = {
										align = left
										text = "[Character.GetFirstNameBase]"
									}
								}
								spacer = { size = { 00 5 } }
								# Opens zz_valyria_archive_select_character_interaction (crafter mode): the game's character list with search, like the cast window's Select Mage
								button_standard = {
									onclick = "[GetScriptedGui('zz_valyria_archive_open_selection').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_archive_selection_mode', MakeScopeFlag('crafter') ).End )]"
									text_single = {
										raw_text = "Select Mage"
										fontsize = 18
										resizeparent = yes
										align = center|nobaseline
										default_format = "#low"
										margin = { 15 15 }
									}
								}
								spacer = { size = { 00 5 } }
								text_single = {
									align = left
									raw_text = "Higher Mysteries - [GetPlayer.MakeScope.Var('zz_item_crafter').ScriptValue('zz_valyria_higher_mysteries_stat_gui')|0]"
								}
								spacer = { size = { 00 20 } }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding 
							layoutpolicy_vertical = expanding
							max_width = 320
							text_single = {
								raw_text = "Item Selection"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }
							scrollbox = {
								name = "item_scrollarea"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								max_width = 300
								#max_height = 450
								blockoverride "scrollbox_content"
								{
									fixedgridbox = {
										addcolumn = 280
										addrow = 55
										datamodel = "[GetPlayer.MakeScope.GetList('zz_valyria_item_list')]"
										item = {
											button_standard = {
												parentanchor = top|left
												datacontext = "[GetScriptedGui('zz_valyria_magic_item_selection')]"
												minimumsize = { 270 38 }
												text_single = {
													minimumsize = { 100 38 }
													margin = { 15 15 }
													text = "[Scope.GetFlagName]"
													alwaystransparent = yes
													resizeparent = yes
													align = center|nobaseline
													default_format = "#low"
												}
												datacontext = "[GetScriptedGui('zz_valyria_magic_item_selection')]"
												onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_item', MakeScopeFlag(Scope.GetFlagKey) ).End)]"
												down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_item', MakeScopeFlag(Scope.GetFlagKey) ).End)]"
												enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_item', MakeScopeFlag(Scope.GetFlagKey) ).End)]"
												tooltip = "[Localize(Concatenate(Scope.GetFlagKey, '_desc' ))]"
											}	
										}
									}
									expand = {}
								}
							}
							spacer = { size = { 0 10 } }
							expand = {}
							vbox = {
								text_single = {
									align = left
									raw_text = "[GetPlayer.MakeScope.Var('zz_selected_item').GetFlagName]"
								}
							}
							vbox = {
								layoutpolicy_horizontal = expanding 
								layoutpolicy_vertical = expanding
								text_multi = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									minimumsize = { 300 300 }
									max_width = 300
									min_width = 300
									autoresize = yes
									text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_item').GetFlagKey, '_desc' ))]"
								}
							}
							# Ring look: any of the ten looks, whatever the ring's school (crafting_window_ring_look_view)
							hbox = {
								visible = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_selected_item').GetFlagKey, 'item_ring' )]"
								spacing = 10
								text_single = {
									align = left|nobaseline
									raw_text = "Ring Look: "
									default_format = "#low"
								}
								text_single = {
									visible = "[GetPlayer.MakeScope.Var('zz_ring_look').IsSet]"
									align = left|nobaseline
									raw_text = "[GetPlayer.MakeScope.Var('zz_ring_look').GetFlagName]"
								}
								text_single = {
									visible = "[Not( GetPlayer.MakeScope.Var('zz_ring_look').IsSet )]"
									align = left|nobaseline
									raw_text = "The School's Own"
								}
								button_standard = {
									onclick = "[GetScriptedGui('zz_ring_look_popup_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									text_single = {
										raw_text = "Choose Look"
										margin = { 12 6 }
										resizeparent = yes
										align = center|nobaseline
									}
								}
							}
							expand = {}
						}
						# Four enchantment slots; each opens crafting_window_enchantment_selection_view for that slot
						vbox = {
							layoutpolicy_horizontal = expanding 
							layoutpolicy_vertical = expanding
							max_width = 320
							text_single = {
								raw_text = "Enchantments"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }
							text_single = {
								align = left
								raw_text = "Enchantment 1"
								default_format = "#low"
							}
							button_standard = {
								size = { 300 38 }
								onclick = "[GetScriptedGui('zz_valyria_enchant_popup_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_enchant_slot', MakeScopeFlag('enchant_slot_1') ).End )]"
								down = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_1' )]"
								tooltip = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_modifier').GetFlagKey, '_desc' ))]"
								text_single = {
									parentanchor = center
									align = center|nobaseline
									text = "[GetPlayer.MakeScope.Var('zz_selected_modifier').GetFlagName]"
									alwaystransparent = yes
								}
							}
							spacer = { size = { 0 8 } }
							text_single = {
								align = left
								raw_text = "Enchantment 2"
								default_format = "#low"
							}
							button_standard = {
								size = { 300 38 }
								onclick = "[GetScriptedGui('zz_valyria_enchant_popup_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_enchant_slot', MakeScopeFlag('enchant_slot_2') ).End )]"
								down = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_2' )]"
								tooltip = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_modifier_2').GetFlagKey, '_desc' ))]"
								text_single = {
									parentanchor = center
									align = center|nobaseline
									text = "[GetPlayer.MakeScope.Var('zz_selected_modifier_2').GetFlagName]"
									alwaystransparent = yes
								}
							}
							spacer = { size = { 0 8 } }
							text_single = {
								align = left
								raw_text = "Enchantment 3"
								default_format = "#low"
							}
							button_standard = {
								size = { 300 38 }
								onclick = "[GetScriptedGui('zz_valyria_enchant_popup_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_enchant_slot', MakeScopeFlag('enchant_slot_3') ).End )]"
								down = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_3' )]"
								tooltip = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_modifier_3').GetFlagKey, '_desc' ))]"
								text_single = {
									parentanchor = center
									align = center|nobaseline
									text = "[GetPlayer.MakeScope.Var('zz_selected_modifier_3').GetFlagName]"
									alwaystransparent = yes
								}
							}
							spacer = { size = { 0 8 } }
							text_single = {
								align = left
								raw_text = "Enchantment 4"
								default_format = "#low"
							}
							button_standard = {
								size = { 300 38 }
								onclick = "[GetScriptedGui('zz_valyria_enchant_popup_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_enchant_slot', MakeScopeFlag('enchant_slot_4') ).End )]"
								down = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_4' )]"
								tooltip = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_modifier_4').GetFlagKey, '_desc' ))]"
								text_single = {
									parentanchor = center
									align = center|nobaseline
									text = "[GetPlayer.MakeScope.Var('zz_selected_modifier_4').GetFlagName]"
									alwaystransparent = yes
								}
							}
							spacer = { size = { 0 8 } }
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = growing 
							layoutpolicy_vertical = growing
							max_width = 200
							spacer = { size = { 0 30 } }
							text_single = {
								Raw_Text = "Magic Regeants"
								fontsize = 24
								align = center
							}							
							spacer = { size = { 00 10 } }
							vbox = {
								button_standard = {
									datacontext = "[GetScriptedGui('zz_valyria_magic_item_craft_none')]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									widget = {
										size = { 100 50 }
										text_single = {
											Raw_Text = "None"
											fontsize = 18
											resizeparent = yes
											align = center|nobaseline
											default_format = "#low"		
											margin = { 5 5 }
										}	
									}
									
								}
								button_standard = {
									datacontext = "[GetScriptedGui('zz_valyria_magic_item_craft_mages_power')]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									widget = {
										size = { 100 50 }
										text_single = {
											Raw_Text = "Magic Power"
											fontsize = 18
											resizeparent = yes
											align = center|nobaseline
											default_format = "#low"		
											margin = { 5 5 }
										}	
									}
								}
								button_standard = {
									datacontext = "[GetScriptedGui('zz_valyria_magic_item_craft_human_sacrifice')]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									widget = {
										size = { 100 50 }
										text_single = {
											Raw_Text = "Human Sacrifice"
											fontsize = 18
											resizeparent = yes
											align = center|nobaseline
											default_format = "#low"		
											margin = { 5 5 }
										}	
									}
								}
								expand = {}
							}
							spacer = { size = { 00 200 } }
							vbox = {
								layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
								vbox = {
									layoutpolicy_horizontal = growing 
									layoutpolicy_vertical = growing
									text_single = {
										Raw_Text = "Current Cost"
										fontsize = 18
										min_width = 100
										align = center|nobaseline
										default_format = "#low"
									}							
									spacer = { size = { 0 10 } }						
									text_single = {
										raw_text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_current_cost')|0] "
										min_width = 100
										align = center|nobaseline
										default_format = "#low"
									}
									expand = {}
								}
								spacer = { size = { 0 50 } }	
								vbox = {
									layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
									text_single = {
										Raw_Text = "Availaible Resources"
										fontsize = 18
										min_width = 100
										align = center|nobaseline
										default_format = "#low"
									}								
									spacer = { size = { 0 10 } }						
									text_single = {
										raw_text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_resources_current_spend')|0] "
										min_width = 100
										align = center|nobaseline
										default_format = "#low"
									}
									expand = {}
								}

							}
							spacer = { size = { 00 100 } }
							button_standard = {
								text_single = {
									minimumsize = { 200 38 }
									margin = { 15 15 }
									raw_text = "Craft Item"
									resizeparent = yes
									align = center|nobaseline
									default_format = "#low"								
								}
								datacontext = "[GetScriptedGui('zz_valyria_magic_item_craft')]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								tooltip = "[GetScriptedGui('zz_valyria_magic_craft_chance_ui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							}
							expand = {}
						}
					}
					# Potions tab: crafter, the potion list, and the chosen potion with its cost and the Brew button
					hbox = {
						visible = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_crafting_tab').GetFlagKey, 'potions' )]"
						layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
						background = {
							using = Background_Area_Dark
						}
						vbox = {
							layoutpolicy_horizontal = growing
							layoutpolicy_vertical = growing
							max_width = 220
							spacer = { size = { 0 30 } }
							text_single = {
								raw_text = "Brewer"
								fontsize = 18
								align = left
							}
							spacer = { size = { 0 15 } }
							vbox = {
								size = { 200 120 }
								datacontext = "[GetPlayer.MakeScope.Var('zz_item_crafter').Char]"
								portrait_head_small = {}
								text_single = {
									align = left
									text = "[Character.GetFirstNameBase]"
								}
							}
							spacer = { size = { 0 5 } }
							button_standard = {
								onclick = "[GetScriptedGui('zz_valyria_archive_open_selection').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_archive_selection_mode', MakeScopeFlag('crafter') ).End )]"
								text_single = {
									raw_text = "Select Mage"
									fontsize = 18
									resizeparent = yes
									align = center|nobaseline
									default_format = "#low"
									margin = { 15 15 }
								}
							}
							spacer = { size = { 0 5 } }
							text_single = {
								align = left
								raw_text = "Alchemy - [GetPlayer.MakeScope.Var('zz_item_crafter').ScriptValue('zz_valyria_alchemy_magic_stat_gui')|0]"
							}
							text_single = {
								align = left
								raw_text = "Potion Strength - [GetPlayer.MakeScope.Var('zz_item_crafter').ScriptValue('zz_valyria_potion_strength_value')|0]"
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							max_width = 320
							text_single = {
								raw_text = "Potions"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }
							scrollbox = {
								name = "potion_scrollarea"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								max_width = 300
								blockoverride "scrollbox_content"
								{
									fixedgridbox = {
										addcolumn = 280
										addrow = 50
										datamodel = "[GetPlayer.MakeScope.GetList('zz_valyria_potion_list')]"
										datamodel_reuse_widgets = yes
										item = {
										button_standard = {
											size = { 270 45 }
											datacontext = "[GetScriptedGui('zz_valyria_magic_potion_selection')]"
											onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_potion', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
											down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_potion', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
											enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_potion', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
											tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_potion', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
											text_single = {
												parentanchor = center
												align = center|nobaseline
												text = "[Scope.GetFlagName]"
												max_width = 250
												alwaystransparent = yes
											}
										}
										}
									}
								}
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							max_width = 320
							spacer = { size = { 0 30 } }
							text_single = {
								raw_text = "[GetPlayer.MakeScope.Var('zz_selected_potion').GetFlagName]"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 15 } }
							text_multi = {
								visible = "[GetPlayer.MakeScope.Var('zz_selected_potion').IsSet]"
								text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('zz_selected_potion').GetFlagKey, '.tooltip.desc' ))]"
								autoresize = yes
								max_width = 310
								align = center|nobaseline
							}
							spacer = { size = { 0 40 } }
							text_single = {
								raw_text = "Current Cost"
								fontsize = 18
								align = center|nobaseline
								default_format = "#low"
							}
							text_single = {
								raw_text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_current_potion_cost')|0]"
								align = center|nobaseline
								default_format = "#low"
							}
							spacer = { size = { 0 20 } }
							text_single = {
								raw_text = "Availaible Resources"
								fontsize = 18
								align = center|nobaseline
								default_format = "#low"
							}
							text_single = {
								raw_text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_resources_current_spend')|0]"
								align = center|nobaseline
								default_format = "#low"
							}
							spacer = { size = { 0 40 } }
							button_standard = {
								datacontext = "[GetScriptedGui('zz_valyria_magic_potion_brew')]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								text_single = {
									minimumsize = { 200 38 }
									margin = { 15 15 }
									raw_text = "Brew Potion"
									resizeparent = yes
									align = center|nobaseline
									default_format = "#low"
								}
							}
							expand = {}
						}
					}
				}
			}
		}
		crafting_window_sword_selection_view = {}
		crafting_window_ring_selection_view = {}
