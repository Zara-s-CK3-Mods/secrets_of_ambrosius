									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_modifier_2', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
									tooltip = "[Localize(Concatenate(Scope.GetFlagKey, '_desc' ))]"
									text_single = {
										parentanchor = center
										align = center|nobaseline
										text = "[Scope.GetFlagName]"
										alwaystransparent = yes
									}
								}
