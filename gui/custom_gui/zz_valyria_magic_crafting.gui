	type crafting_window_enchantment_selection_view = window {
		name = "crafting_window_enchantment_selection_view"
		movable = no
		layer = confirmation
		parentanchor = top|hcenter
		position = { -500 20 }
		size = { 320 90% }
		using = Animation_ShowHide_Quick
		using = Window_Background_Subwindow
		visible = "[GetPlayer.MakeScope.Var('zz_enchant_popup').IsSet]"
		vbox = {
			margin = { 4 4 }
			margin_bottom = 15
			margin_top = 15
			spacing = 15
			header_pattern = {
				layoutpolicy_horizontal = expanding
				blockoverride "header_text"
				{
					raw_text = "Select Enchantment"
				}
				blockoverride "button_close"
				{
					onclick = "[GetScriptedGui('zz_valyria_enchant_popup_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}
			scrollbox = {
				name = "enchantment_scrollarea"
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				size = { 295 80% }
				background = {
					using = Background_Area_Dark
				}
				blockoverride "scrollbox_content"
				{
					fixedgridbox = {
						addcolumn = 280
						addrow = 45
						datamodel = "[GetPlayer.MakeScope.GetList('zz_valyria_modifier_list')]"
						datamodel_reuse_widgets = yes
						item = {
							widget = {
								size = { 270 38 }
								button_standard = {
									visible = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_1' )]"
									parentanchor = top|left
									size = { 270 38 }
									datacontext = "[GetScriptedGui('zz_valyria_magic_modifier_selection')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_modifier', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
									down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_modifier', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_selected_modifier', MakeScopeFlag(Scope.GetFlagKey) ).End )]"
									tooltip = "[Localize(Concatenate(Scope.GetFlagKey, '_desc' ))]"
									text_single = {
										parentanchor = center
										align = center|nobaseline
										text = "[Scope.GetFlagName]"
										alwaystransparent = yes
									}
								}
								button_standard = {
									visible = "[EqualTo_string( GetPlayer.MakeScope.Var('zz_enchant_popup').GetFlagKey, 'enchant_slot_2' )]"
