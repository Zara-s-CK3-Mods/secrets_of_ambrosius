	type magic_spell_list = scrollbox {
		name = "spell_scrollarea"
		block "visible" {
			visible = "[GetVariableSystem.HasValue( 'magic_page','higher_mysteries')]"
		}
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		max_width = 550
		#max_height = 500
		blockoverride "scrollbox_content"
		{
			magic_spell_list_grid = {
				blockoverride "datamodel" {
					datamodel = "[Scope.GetList('zz_valyria_spell_list')]"
				}
			}
			expand = {}
		}
	}
	# A vertical flowcontainer rather than a fixedgridbox, so spells hidden by the keyword search close up
	# Spacing 17 plus the 38-high entries keeps the old 55-pixel rows
	type magic_spell_list_grid = flowcontainer {
		direction = vertical
		spacing = 17
		ignoreinvisible = yes
		layoutpolicy_vertical = growing
		minimumsize = { 500 -1 }
		datacontext = "[GetPlayer.MakeScope]"
		block "datamodel" {
			datamodel = "[Scope.GetList('zz_valyria_spell_list')]"
		}
		
		item = {
			magic_list_item = {}
		}
	}

