	type zz_magic_cast_army_button = widget
	{
		size = { 42 45 }
		datacontext = "[Army.GetOwner]"
		button_round = {
			name = "button_zz_cast_magic"
			visible = "[And(GetScriptedGui('zz_valyria_army_cast_click').IsShown(GetPlayer.MakeScope), Character.IsValid)]"
			using = "zz_magic_cast_close_windows"

			onclick = "[GetScriptedGui('zz_valyria_army_cast_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('opened_character', Character.MakeScope).AddScope('selected_province', Army.GetLocation.MakeScope).AddScope('selected_army', Army.MakeScope).End)]"
			onclick = "[ArmyWindow.CloseAndDeselect]"
			using = tooltip_ne
			tooltip = "ZZ_CAST_MYSTERY_TT"
			parentanchor = center
			size = { 38 38 }
			button_icon = {
				texture = "gfx/interface/icons/zz_magic_casting.dds"
