types magic_casting {
	type magic_casting_window_open = window {
		name = "magic_casting_window_open"
		allow_outside = yes
		layer = windows_layer
		movable = yes
		parentanchor = top|right
		alwaystransparent = yes
		size = { 100% 100% }

		visible = "[And( Not( IsPauseMenuShown ), And(Or(Not(IsObserver), GetPlayer.IsValid), IsDefaultGUIMode))]"
		zz_magic_window = {}
		zz_valyria_magic_scroll_learning = {}
		zz_valyria_magic_crafting = {}
		zz_spellbook_window = {}

		# Disarms the casting map mode once the map leaves it
		widget = {
			size = { 0 0 }
			state = {
				name = zz_casting_map_disarm
				next = zz_casting_map_idle
				trigger_when = "[And( Not( IsMapMode( 'zz_magic_casting' ) ), GetVariableSystem.Exists( 'zz_casting_map_armed' ) )]"
				on_start = "[GetVariableSystem.Clear( 'zz_casting_map_armed' )]"
				on_start = "[GetScriptedGui('zz_valyria_casting_map_disarm').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			state = {
				name = zz_casting_map_idle
			}
		}
	}
	type zz_magic_window = window {
		name = "zz_magic_window"
		layer = middle

		allow_outside = yes
		parentanchor = top|right
		size = { 900 100% }
		datacontext = "[GetScriptedGui('zz_valyria_magic_casting')]"
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
		#visible = "[IsGameViewOpen('character')]"
		using = Window_Background
		using = Window_Decoration
		movable = no
		oncreate = "[PdxGuiWidget.StackTop]"
		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			using = Window_Position_MainTab
			on_start  = "[GetVariableSystem.Set('magic_page','higher_mysteries')]"
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			using = Window_Position_MainTab_Hide
		}

		margin_widget = {
			size = { 100% 100% }
			margin = { 0 30 }
			margin_right = 13

			widget = {
				size = { 100% 100% }
				background = {
					texture = "gfx/interface//illustrations/magic_casting/zz_magic_casting_background.dds"
					margin = { -25 -25 }
					fittype = centercrop
					alpha = 1

					using = Mask_Rough_Edges

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}
				}
				vbox = {
					using = Window_Margins

					header_pattern = {
						layoutpolicy_horizontal = expanding

						blockoverride "header_text"
						{
							raw_text = "Magic Casting"
						}

						blockoverride "button_close"
						{
							onclick = "[GetScriptedGui('zz_valyria_magic_casting_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}
					}
					spacer = { size = { 00 5 } }
					hbox = {
						margin_right = 13
						margin_left = 13

						layoutpolicy_horizontal = expanding
						expand = {}
						button_tab = {
							name = "mage_casting_tab"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							align = center
							minimumsize = { 100 38 }
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 5
								margin = { 5 5 }
								text_single = {
									raw_text = "Mage Casting"
									alwaystransparent = yes
								}
							}
							datacontext = "[GetScriptedGui('zz_valyria_magic_casting_mystery')]"
							#onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							down = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							shortcut = "_shift_1"
							onclick = "[GetScriptedGui('zz_valyria_magic_casting_mystery_click').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}
						button_tab = {
							name = "scroll_casting_tab"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							align = center
							minimumsize = { 100 38 }
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 5
								margin = { 5 5 }
								text_single = {
									raw_text = "Scroll Casting"
									alwaystransparent = yes
								}

							}

							datacontext = "[GetScriptedGui('zz_valyria_magic_casting_scroll_casting')]"
							#onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							#enabled = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							down = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							shortcut = "_shift_2"
							onclick = "[GetScriptedGui('zz_valyria_magic_casting_scroll_casting_click').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}

						expand = {}
					}
					expand = {}
					spacer = { size = { 00 5 } }
					hbox = {
						margin_bottom = 20
						layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
						visible = "[GetScriptedGui('zz_valyria_magic_casting_mystery').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"

						datacontext = "[GetPlayer.MakeScope]"

						background = {
							texture = "[Illustration.GetTexture( GetPlayer.MakeScope )]"
							margin = { -5 0 }
							fittype = centercrop
							alpha = 1

							using = Mask_Rough_Edges

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								mirror = vertical
							}
						}
						background = {
							using = Background_Area_Dark
						}
						vbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding
							max_width = 250
							spacer = { size = { 0 30 } }
							text_single = {
								raw_text = "Mage"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								background = {
									using = Background_Area_Dark
								}
								datacontext = "[GetPlayer.MakeScope.Var('zz_magic_caster').Char]"
								vbox = {
									size = { 200 120 }
									
									portrait_head_small = {}
									text_single = {
										align = left
										text = "[Character.GetFirstNameBase]"
									}
								}
								spacer = { size = { 00 5 } }
								button_standard = {
									# Opens zz_valyria_select_caster_interaction (the game's character list with search) instead of zz_magic_window_mages_selection_view
									onclick = "[GetScriptedGui('zz_valyria_magic_open_caster_selection').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									text_single = {
										raw_text = "Select Mage"
										fontsize = 18
										resizeparent = yes
										align = center|nobaseline
										default_format = "#low"
										margin = { 15 15 }
									}
								}
								spacer = { size = { 00 5 } }
								magic_caster_stats = {
									blockoverride "datacontext" {
										datacontext = "[GetPlayer.MakeScope().Var('zz_magic_caster').Char]"
									}
								}
								expand = {}
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacer = { size = { 0 30 } }
							max_width = 550
							text_single = {
								text = game_concept_zz_mystery
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }
							widget = {
								size = { 300 40}
								hbox = {
									layoutpolicy_horizontal = expanding
									background = {
										using = Background_Area_Dark
									}
									expand = {}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_higher_mysteries"
											texture = "gfx/interface/icons/trait_level_tracks/secrets_of_the_higher_mysteries.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','higher_mysteries' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_blood_magic"
											texture = "gfx/interface/icons/trait_level_tracks/blood_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','blood_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_shadow_magic"
											texture = "gfx/interface/icons/trait_level_tracks/shadow_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','shadow_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_dream_magic"
											texture = "gfx/interface/icons/trait_level_tracks/dream_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','dream_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_alchemy_magic"
											texture = "gfx/interface/icons/trait_level_tracks/alchemy_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','alchemy_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_fire_magic"
											texture = "gfx/interface/icons/trait_level_tracks/fire_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','fire_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_air_magic"
											texture = "gfx/interface/icons/trait_level_tracks/air_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','air_magic' ) ]"
									}
									button_normal = {
										size = { 30 30}
										icon = {
											name = "icon_water_magic"
											texture = "gfx/interface/icons/trait_level_tracks/water_magic.dds"
											size = { 100% 100% }
										}
										onclick = "[GetVariableSystem.Set( 'magic_page','water_magic' ) ]"
									}
									expand = {}
								}
							}
							# Keyword search: opens zz_valyria_magic_search.1, shows the stored text and clears it
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10
								button_standard = {
									size = { 100 30 }
									text = "zz_spell_search_button"
									tooltip = "zz_spell_search_button_tt"
									datacontext = "[GetScriptedGui('zz_valyria_magic_spell_search')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								text_single = {
									visible = "[Not( StringIsEmpty( GetPlayer.GetLocalizedText('zz_spell_search') ) )]"
									text = "zz_spell_search_showing"
									default_format = "#low"
								}
								button_standard = {
									visible = "[Not( StringIsEmpty( GetPlayer.GetLocalizedText('zz_spell_search') ) )]"
									size = { 30 30 }
									text = "zz_spell_search_clear_button"
									tooltip = "zz_spell_search_clear_button_tt"
									datacontext = "[GetScriptedGui('zz_valyria_magic_spell_search_clear')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								expand = {}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','higher_mysteries')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','blood_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_blood_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','shadow_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_shadow_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','dream_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_dream_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','alchemy_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_alchemy_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','fire_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_fire_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','air_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_air_list')]"
										}
									}
									expand = {}
								}
							}
							magic_spell_list = {
								blockoverride "visible" {
									visible = "[GetVariableSystem.HasValue( 'magic_page','water_magic')]"
								}
								blockoverride "scrollbox_content"
								{
									magic_spell_list_grid = {
										blockoverride "datamodel" {
											datamodel = "[Scope.GetList('zz_valyria_spell_water_list')]"
										}
									}
									expand = {}
								}
							}
							spacer = { size = { 0 10 } }
							flowcontainer = {
								text_single = {
									align = left
									raw_text = "[Scope.Char.MakeScope.Var('zz_valyria_mystery').CharacterMemory.GetName|U]"
								}
							}
							spacer = { size = { 00 25 } }
							hbox = {
								button_standard = {
									text_single = {
										minimumsize = { 200 38 }
										margin = { 15 15 }
										raw_text = "Enact Mystery"
										resizeparent = yes
										align = center|nobaseline
										default_format = "#low"
									}
									datacontext = "[GetScriptedGui('zz_valyria_magic_cast')]"
									shortcut = "_return"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
								}
								spacer = {
									size = { 20 0 }
								}
							}

							expand = {}
						}
					}
					hbox = {
						margin_bottom = 20
						layoutpolicy_horizontal = expanding   layoutpolicy_vertical = expanding
						visible = "[GetScriptedGui('zz_valyria_magic_casting_scroll_casting').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"

						datacontext = "[GetPlayer.MakeScope]"

						background = {
							texture = "[Illustration.GetTexture( GetPlayer.MakeScope )]"
							margin = { -5 0 }
							fittype = centercrop
							alpha = 1

							using = Mask_Rough_Edges

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								mirror = vertical
							}
						}
						background = {
							using = Background_Area_Dark
						}
						vbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding
							spacer = { size = { 0 30 } }
							max_width = 250
							text_single = {
								raw_text = "Item User"
								fontsize = 24
								align = center
							}
							vbox = {
								layoutpolicy_horizontal = growing
								layoutpolicy_vertical = growing
								background = {
									using = Background_Area_Dark
								}
								spacer = { size = { 0 30 } }
								max_width = 200
								max_height = 300
								datacontext = "[GetPlayer.MakeScope.Var('zz_item_caster').Char]"
								vbox = {
									size = { 200 120 }
									portrait_head_small = {}
									text_single = {
										align = left
										text = "[Character.GetFirstNameBase]"
									}
								}
								spacer = { size = { 00 5 } }
								button_standard = {
									onclick = "[GetVariableSystem.Toggle('zz_magic_window_scroll_user_selection_view')]"
									text_single = {
										raw_text = "Select Scroll Caster"
										fontsize = 18
										resizeparent = yes
										align = center|nobaseline
										default_format = "#low"
										margin = { 15 15 }
									}
								}
								spacer = { size = { 00 5 } }
								magic_caster_stats = {
									blockoverride "datacontext" {
										datacontext = "[GetPlayer.MakeScope().Var('zz_item_caster').Char]"
									}
								}
								spacer = { size = { 00 5 } }

								expand = {}
							}
							spacer = { size = { 00 30 } }
							expand = {}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							max_width = 550
							spacer = { size = { 0 30 } }
							text_single = {
								raw_text = "Scroll"
								fontsize = 24
								align = center
							}
							spacer = { size = { 0 30 } }

							scrollbox = {
								name = "spell_scrollarea"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								max_width = 550
								#max_height = 500
								blockoverride "scrollbox_content"
								{
									fixedgridbox = {
										addcolumn = 500
										addrow = 55
										datacontext = "[GetPlayer.MakeScope]"
										datamodel = "[Scope.GetList('zz_valyria_scroll_list')]"

										item = {
											button_standard = {
												parentanchor = top|left
												datacontext = "[Scope.Artifact]"
												minimumsize = { 500 38 }
												text_single = {
													minimumsize = { 100 38 }
													margin = { 15 15 }
													text = "[Artifact.GetName|U]"
													alwaystransparent = yes
													resizeparent = yes
													align = center|nobaseline
													default_format = "#low"
												}
												tooltip = "[Localize(Concatenate(Artifact.MakeScope.Var('spell_name').GetFlagKey,'.tooltip.desc' ))]"
												#tooltip = "[Localize(Concatenate(Concatenate(Artifact.MakeScope.Var('spell_school').GetFlagKey, '.'), Concatenate(Artifact.MakeScope.Var('spell_number').GetFlagKey,'.tooltip.desc' )))]"
												
												datacontext = "[GetScriptedGui('zz_valyria_item_scroll_01')]"
												onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_valyria_scroll', Artifact.MakeScope ).End)]"
												down = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_valyria_scroll', Artifact.MakeScope ).End)]"
												enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_valyria_scroll', Artifact.MakeScope ).End)]"
																	}
										}
									}
									expand = {}
								}
							}
							spacer = { size = { 0 10 } }
							flowcontainer = {
								text_single = {
									align = left
									raw_text = "[Scope.Char.MakeScope.Var('zz_valyria_scroll').Artifact.GetName|U]"
								}
							}
							spacer = { size = { 00 25 } }

							button_standard = {
								text_single = {
									minimumsize = { 200 38 }
									margin = { 15 15 }
									raw_text = "Use Scroll"
									resizeparent = yes
									align = center|nobaseline
									default_format = "#low"
								}
								shortcut = "_return"
								datacontext = "[GetScriptedGui('zz_valyria_magic_scroll_cast')]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							}
							expand = {}
						}
					}
				}
			}
		}
		zz_magic_window_mages_selection_view = {}
		zz_magic_window_scroll_user_selection_view = {}
	}
	type zz_magic_window_mages_selection_view = window {
		name = "zz_magic_window_mages_selection_view"
		movable = no
		layer = confirmation
		parentanchor = top|hcenter
		position = { -600 20 }

		size = { 400 95% }

		using = Animation_ShowHide_Quick

		using = Window_Background_Subwindow
		visible = "[GetVariableSystem.Exists('zz_magic_window_mages_selection_view')]"
		vbox = {
			#set_parent_size_to_minimum = yes
			margin = { 4 4 }
			margin_bottom = 15
			margin_top = 15
			spacing = 15

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					raw_text = "Select Mages"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Toggle('zz_magic_window_mages_selection_view')]"
				}
			}
			expand = {}
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				size = { 300 85%}
				scrollbox = {
					name = "mages_scrollarea"
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					parentanchor = top|left
					size = { 275 90%}
					background = {
						using = Background_Area_Dark
					}
					blockoverride "scrollbox_content"
					{
						fixedgridbox = {
							addcolumn = 300
							addrow = 105
							datamodel = "[GetPlayer.MakeScope.GetList('mage_list')]"
							datamodel_reuse_widgets = yes

							item = {
								button_standard = {
									parentanchor = top|left
									size = { 300 100 }
									align = left
									datacontext = "[Scope.GetCharacter]"
									layoutpolicy_vertical = expanding
									layoutpolicy_horizontal = growing

									down = "[ObjectsEqual( GetPlayer.MakeScope.Var('zz_magic_caster').Char.Self, Character.Self )]"
									onclick = "[GetScriptedGui('zz_valyria_magic_caster').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_magic_caster', Character.MakeScope ).End )]"
									onclick = "[GetVariableSystem.Toggle('zz_magic_window_mages_selection_view')]"
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										margin_right = 4
										spacing = 5
										portrait_head_small = {}
										text_single = {
											text = "[Character.GetFirstNameBase]"
										}
										spacer = { size = { 00 15 } }
									}
								}
							}
						}
					}
				}
			}
			expand = {}
		}
	}
	type zz_magic_window_scroll_user_selection_view = window {
		name = "zz_magic_window_scroll_user_selection_view"
		movable = no
		layer = confirmation
		parentanchor = top|hcenter
		position = { -600 20 }

		size = { 400 95% }

		using = Animation_ShowHide_Quick

		using = Window_Background_Subwindow
		visible = "[GetVariableSystem.Exists('zz_magic_window_scroll_user_selection_view')]"
		vbox = {
			#set_parent_size_to_minimum = yes
			margin = { 4 4 }
			margin_bottom = 15
			margin_top = 15
			spacing = 15

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					raw_text = "Select Mages"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Toggle('zz_magic_window_scroll_user_selection_view')]"
				}
			}
			expand = {}
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				size = { 300 85%}
				scrollbox = {
					name = "mages_scrollarea"
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					parentanchor = top|left
					size = { 275 90%}
					background = {
						using = Background_Area_Dark
					}
					blockoverride "scrollbox_content"
					{
						fixedgridbox = {
							addcolumn = 300
							addrow = 105
							datamodel = "[GetPlayer.MakeScope.GetList('item_caster_list')]"
							datamodel_reuse_widgets = yes

							item = {
								button_standard = {
									parentanchor = top|left
									size = { 300 100 }
									align = left
									datacontext = "[Scope.GetCharacter]"
									layoutpolicy_vertical = expanding
									layoutpolicy_horizontal = growing

									down = "[ObjectsEqual( GetPlayer.MakeScope.Var('zz_item_caster').Char.Self, Character.Self )]"
									onclick = "[GetScriptedGui('zz_valyria_magic_item_caster').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'zz_item_caster', Character.MakeScope ).End )]"
									onclick = "[GetVariableSystem.Toggle('zz_magic_window_scroll_user_selection_view')]"
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										margin_right = 4
										spacing = 5
										portrait_head_small = {}
										text_single = {
											text = "[Character.GetFirstNameBase]"
										}
										spacer = { size = { 00 15 } }
									}
								}
							}
						}
					}
				}
			}
			expand = {}
		}
	}

