	}	

	type zz_magic_cast_button = button_round {
		name = "knight_tree_button"
		visible = "[GetScriptedGui('zz_valyria_cast_click').IsShown(GetPlayer.MakeScope)]"
		block "size" {
			size = { 35 35 }
		}
		using = "zz_magic_cast_close_windows"

		onclick = "[GetScriptedGui('zz_valyria_cast_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('opened_character', Character.MakeScope).End)]"
		using = tooltip_ne
		tooltip = "ZZ_CAST_MYSTERY_TT"
		button_icon = {
			texture = "gfx/interface/icons/zz_magic_casting.dds"
			parentanchor = center
			alwaystransparent = yes
			block "icon_size" {
				size = { 25 25 }
			}
			
		}
	}
